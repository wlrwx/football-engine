__pycache__/
*.pyc
.env
*.egg-info/
dist/
.venv/
venv/
# Cloudflare wrangler 缓存（含账号 PII，勿提交）
.wrangler/
cf-proxy/.wrangler/
# 备份文件
*.bak
*.bak*
.DS_Store
logs/

# 可重抓的原始赔率缓存（CI 每次运行前由 scripts/fetch_sina_odds.py 重新抓取；
# 10k+ 行/天，写进 git 历史会导致仓库无限膨胀。不可变决策记录
# （predictions/results/review/ticket_plan/decision_bundle/plan_lock）仍保留在 git。）
data/daily/*/odds_sina.json
# football-data.co.uk 原始 CSV（scripts/import_football_data.py 可随时重抓；
# 汇总 JSON data/state/football_data_baselines.json 仍提交）
data/historical/football_data/

# NJStats 试用窗口的原始 API 归档（2026-10-13 起不入 git）。
# 与上面两条同一政策：原始可重抓数据不进 git，派生结论才进。
# 规模实测：prob 8 端点 × 6 页 × 每天 ≈ 33MB，且每小时新增；
# 写进 git 会让每次 clone 多背 30MB+。已入历史的 129 个文件保留不动
# （清历史要 force-push，需用户裁决）。
# 真正不可再得的是 10-15 试用到期后的数据——所以**导出走 Release/外部备份**，
# 不走 git。派生特征 data/state/njstats_features/ 仍提交（小、且是结论）。
data/state/njstats_archive/

# 本地侦察保险库——端点/密钥/会话细节绝不入公开仓库
_vault/

# 自治进化闭环的运行产物（PR 与 Actions 生成）
evolution/out/
evolution/out_live/
evolution/out_converge/

# 本机 duty 的社区快照日期门控 marker（per-host，勿入库）
data/state/.community_snapshot_done

# CI 看门狗的上次补触发时间（per-host 节流用）
.ci_watchdog_last

# football-data.co.uk 原始缓存与派生表：每次运行重新生成，不入 git
# （2026-10-28：此前 43 个 CSV + 26MB parsed.jsonl 全在版本库里，一旦恢复
#  每日刷新，会以约 10MB/天的速度膨胀历史；解析结果由 fetch_football_data.py
#  在 CI 同一步重新生成，因此在仓库里留 status.json + clv_pinnacle.json 即可）
data/state/fdc/*.csv
data/state/fdc/parsed.jsonl
